{
  "name": "ledesift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test --project=chromium-mocked",
    "test:e2e:live": "npm run build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --project=chromium-live",
    "smoke:summarize": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/ai/live-gemini.integration.test.ts --testTimeout=45000",
    "smoke:fullstack": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/api/live-fullstack.integration.test.ts --testTimeout=90000"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
